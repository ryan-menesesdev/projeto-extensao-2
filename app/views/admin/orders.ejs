<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Fila de Pedidos</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/admin/orders.css">
    <link rel="stylesheet" href="/css/admin/back.css">
    <link rel="icon" type="image/png" href="images/logo-better-nobackground.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

<div class="container">
    <div class="page-header">
        <div class="top-container">
            <a class="top-link" href="/admin/home" aria-label="Voltar para a página inicial">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                <span>Voltar</span>
            </a>
        </div>

        <div class="page-header-content">
            <h1 class="page-title"><i class="fas fa-receipt"></i> Fila de Pedidos</h1>
            
            <div class="filter-group">
                <a href="/admin/orders" 
                class="btn-filter ">
                Todos
                </a>

                <a href="/admin/orders?status=emAnalise" 
                class="btn-filter">
                Em Análise
                </a>

                <a href="/admin/orders?status=preparando" 
                class="btn-filter">
                Preparando
                </a>

                <a href="/admin/orders?status=confirmado" 
                class="btn-filter">
                Confirmado
                </a>

                <a href="/admin/orders?status=finalizado" 
                class="btn-filter">
                Finalizado
                </a>

                <a href="/admin/orders?status=recusado" 
                class="btn-filter">
                Recusado
                </a>
            </div>
        </div>
    </div>

    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th>Cliente</th>
                    <th>Data/Hora</th>
                    <th>Pagamento</th>
                    <th>Status Atual</th>
                    <th style="width: 200px;">Alterar Status</th>
                </tr>
            </thead>
            <tbody>
                <% if(!orders || orders.length === 0) { %>
                    <tr><td colspan="6" style="text-align: center; padding: 30px;">Nenhum pedido encontrado.</td></tr>
                <% } %>

                <% orders.forEach(order => { %>
                <tr>
                    <td>
                        <a href="/admin/orders/<%= order.id %>" 
                        title="Ver detalhes do pedido" 
                        style="color: #b71c1c; text-decoration: underline; cursor: pointer;">
                            <strong>#<%= order.id %></strong>
                        </a>
                    </td>
                    <td><%= order.nomeCliente %></td>
                    <td>
                        <%= new Date(order.criadoEm).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %> 
                        
                        <small style="color: #666;">
                            <%= new Date(order.criadoEm).toLocaleTimeString('pt-BR', { 
                                timeZone: 'America/Sao_Paulo', 
                                hour: '2-digit', 
                                minute:'2-digit' 
                            }) %>
                        </small>
                    </td>
                    <td>
                        <div style="font-size: 0.9rem;">
                            <i class="fas fa-credit-card"></i> <%= order.metodoPagamento %>
                        </div>
                        <% if(order.statusPagamento === 'Aprovado' || order.statusPagamento === 'Pago') { %>
                            <span style="color: #27ae60; font-size: 0.8rem; font-weight: bold;">Pago</span>
                        <% } else { %>
                            <span style="color: #c0392b; font-size: 0.8rem; font-weight: bold;">Pendente</span>
                        <% } %>
                    </td>
                    <td>

                        <% 
                            let badgeClass = 'badge-neutral';
                            let label = order.statusPedido;

                            if(order.statusPedido === 'emAnalise') { badgeClass = 'badge-yellow'; label = 'Em Análise'; }
                            if(order.statusPedido === 'confirmado') { badgeClass = 'badge-blue'; label = 'Confirmado'; }
                            if(order.statusPedido === 'preparando') { badgeClass = 'badge-blue'; label = 'Preparando'; }
                            if(order.statusPedido === 'finalizado') { badgeClass = 'badge-green'; label = 'Finalizado'; }
                            if(order.statusPedido === 'recusado') { badgeClass = 'badge-red'; label = 'Recusado'; }
                        %>
                        <span class="badge <%= badgeClass %>">
                            <%= label %>
                        </span>
                    </td>
                    <td class="actions-cell">
                        
                        <form action="/admin/orders/<%= order.id %>?_method=PATCH" method="POST" class="status-form">
                            
                            <% const isLocked = order.statusPedido === 'finalizado' || order.statusPedido === 'recusado'; %>

                            <select name="statusPedido" class="select-sm" <%= isLocked ? 'disabled' : '' %>>
                                <option value="emAnalise" <%= order.statusPedido === 'emAnalise' ? 'selected' : '' %>>Em Análise</option>
                                <option value="confirmado" <%= order.statusPedido === 'confirmado' ? 'selected' : '' %>>Confirmado</option>
                                <option value="preparando" <%= order.statusPedido === 'preparando' ? 'selected' : '' %>>Preparando</option>
                                <option value="finalizado" <%= order.statusPedido === 'finalizado' ? 'selected' : '' %>>Finalizado</option>
                                <option value="recusado" <%= order.statusPedido === 'recusado' ? 'selected' : '' %>>Recusado</option>
                            </select>

                            <button type="submit" class="btn-sm btn-ok" 
                                    title="<%= isLocked ? 'Pedido finalizado não pode ser alterado' : 'Confirmar alteração' %>"
                                    <%= isLocked ? 'disabled' : '' %>>
                                Ok
                            </button>
                            
                            <% if (isLocked) { %>
                                <span style="font-size: 0.8rem; color: #999; margin-left: 5px;">(Fechado)</span>
                            <% } %>

                        </form>

                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</div>

</body>
</html>