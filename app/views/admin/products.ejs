<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Gerenciar Produtos</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/admin/products.css">
    <link rel="stylesheet" href="/css/admin/back.css">
    <link rel="icon" type="image/png" href="images/logo-better-nobackground.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <main>
        <div class="container">
            
            <div class="page-header">
                <div class="top-container">
                    <a class="top-link" href="/admin/home" aria-label="Voltar para a página inicial">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>
                        <span>Voltar</span>
                    </a>
                </div>
                <div class="page-header-content">
                    <h1 class="page-title"><i class="fas fa-boxes"></i> Estoque de Produtos</h1>
                    <div>
                        <a href="/admin/products/add" class="btn-new">
                            <i class="fas fa-plus-circle"></i> Novo Produto
                        </a>
                    </div>
                </div>
            </div>

            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 50px;">ID</th>
                            <th style="width: 70px;">Img</th>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Preço</th>
                            <th>Status (Disponibilidade)</th>
                            <th style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(products.length === 0) { %>
                            <tr><td colspan="7" style="text-align: center; padding: 30px;">Nenhum produto cadastrado.</td></tr>
                        <% } %>

                        <% products.forEach(p => { %>
                        <tr>
                            <td>#<%= p.id %></td>
                            <td>
                                <img src="<%= p.imagem || '/images/default-product.png' %>" alt="Foto" class="prod-img">
                            </td>
                            <td>
                                <strong><%= p.nome %></strong><br>
                                <small style="color: #777;"><%= p.descricao %></small>
                            </td>
                            <td><%= p.categoria %></td>
                            <td>R$ <%= Number(p.preco).toFixed(2) %></td>
                            <td>
                                <form action="/admin/products/<%= p.id %>?_method=PATCH" method="POST">
                                    <select name="disponivel" class="form-control" style="width: 100%; cursor: pointer;" onchange="this.form.submit()">
                                        <option value="1" <%= p.disponivel ? 'selected' : '' %>>Disponível</option>
                                        <option value="0" <%= !p.disponivel ? 'selected' : '' %>>Indisponível</option>
                                    </select>
                                </form>
                            </td>
                            <td class="actions-cell">
                                <a href="/admin/products/edit/<%= p.id %>" class="action-btn btn-edit" title="Editar">
                                    <i class="fas fa-pen-to-square"></i>
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>