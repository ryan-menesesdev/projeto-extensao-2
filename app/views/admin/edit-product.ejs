<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Editar Produto</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/admin/products.css">
    <link rel="stylesheet" href="/css/admin/back.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <main>
        <div class="container" style="max-width: 800px; margin-top: 50px;">
            <div class="page-header">
                <div class="top-container">
                    <a class="top-link" href="/admin/products" aria-label="Voltar para a página inicial">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>
                        <span>Voltar</span>
                    </a>
                </div>

                <h1 class="page-title">Editar Produto #<%= product.id %></h1>
            </div>

            <div class="table-card" style="padding: 30px;">
                <form action="/admin/products/<%= product.id %>?_method=PUT" method="POST">
                    
                    <div class="form-group">
                        <label>Nome do Produto:</label>
                        <input type="text" name="nome" class="form-control" required value="<%= product.nome %>">
                    </div>

                    <div style="display: flex; gap: 15px;">
                        <div class="form-group" style="flex: 1;">
                            <label>Preço (R$):</label>
                            <input type="number" step="0.01" name="preco" class="form-control" required value="<%= product.preco %>">
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label>Categoria:</label>
                            <input type="text" name="categoria" class="form-control" required value="<%= product.categoria %>">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>URL da Imagem:</label>
                        <input type="text" name="imagem" class="form-control" value="<%= product.imagem %>">
                    </div>

                    <div class="form-group">
                        <label>Descrição:</label>
                        <textarea name="descricao" rows="4" class="form-control" required><%= product.descricao %></textarea>
                    </div>

                    <div class="form-group">
                        <label>Status:</label>
                        <select name="disponivel" class="form-control">
                            <option value="1" <%= product.disponivel ? 'selected' : '' %>>Visível na Loja</option>
                            <option value="0" <%= !product.disponivel ? 'selected' : '' %>>Oculto</option>
                        </select>
                    </div>

                    <div style="margin-top: 20px; text-align: right;">
                        <button type="submit" class="btn-submit" style="padding: 10px 20px; font-size: 16px;">
                            <i class="fas fa-sync-alt"></i> Atualizar Dados
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>