<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <title>Gerenciar Usuários</title>
        
        <link rel="stylesheet" href="/css/reset.css">
        <link rel="stylesheet" href="/css/admin/employees.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    </head>
    <body>
        <main>
            <div class="container">
                
                <div class="page-header">
                    <h1 class="page-title"><i class="fas fa-users-cog"></i> Equipe e Usuários</h1>
                    
                    <a href="/admin/users?newMode=true" class="btn-new">
                        <i class="fas fa-user-plus"></i> Novo Usuário
                    </a>
                </div>

                <div class="table-card">
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 50px;">ID</th>
                                <th>Nome</th>
                                <th>Email</th>
                                <th>Telefone</th>
                                <th>Tipo</th>
                                <th style="width: 120px;">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(!users || users.length === 0) { %>
                                <tr><td colspan="6" style="text-align: center; padding: 30px;">Nenhum usuário encontrado.</td></tr>
                            <% } %>

                            <% users.forEach(u => { %>
                            <tr>
                                <td>#<%= u.id %></td>
                                <td>
                                    <strong><%= u.nome %></strong><br>
                                    <small style="color: #777;">CPF: <%= u.cpf || 'N/A' %></small>
                                </td>
                                <td><%= u.email %></td>
                                <td><%= u.telefone %></td>
                                <td>
                                    <% if(u.tipo && u.tipo.toLowerCase() === 'supervisor') { %>
                                        <span class="badge badge-avail"><i class="fas fa-crown"></i> Supervisor</span>
                                    <% } else if (u.tipo && u.tipo.toLowerCase() === 'funcionario') { %>
                                        <span class="badge badge-staff">
                                            <i class="fas fa-user-tie"></i> Funcionário
                                        </span>
                                    <% } else { %>
                                        <span class="badge badge-neutral">Cliente</span>
                                    <% } %>
                                </td>
                                <td class="actions-cell">
                                    
                                    <a href="/admin/users?editId=<%= u.id %>" class="action-btn btn-edit" title="Editar">
                                        <i class="fas fa-pen-to-square"></i>
                                    </a>

                                    <form action="/admin/users/<%= u.id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('ATENÇÃO: Tem certeza que deseja remover o usuário <%= u.nome %>?');">
                                        <button type="submit" class="action-btn btn-delete" title="Excluir">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    </form>

                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

            </div>

            <% if (typeof isModalOpen !== 'undefined' && isModalOpen) { %>
            <div class="modal-overlay">
                <div class="modal-box">
                    <div class="modal-header">
                        <h3 class="modal-title">
                            <%= selectedUser.id ? 'Editar Usuário' : 'Cadastrar Usuário' %>
                        </h3>
                        <a href="/admin/users" class="btn-close">&times;</a>
                    </div>

                    <% 
                    let actionUrl = selectedUser.id ? `/admin/users/${selectedUser.id}?_method=PUT` : '/admin/users';
                    %>

                    <form action="<%= actionUrl %>" method="POST">
                        
                        <div class="form-group">
                            <label>Nome Completo:</label>
                            <input type="text" name="nome" class="form-control" required value="<%= selectedUser.nome || '' %>">
                        </div>

                        <div style="display: flex; gap: 15px;">
                            <div class="form-group" style="flex: 1;">
                                <label>CPF:</label>
                                <input type="text" name="cpf" class="form-control" placeholder="000.000.000-00" value="<%= selectedUser.cpf || '' %>">
                            </div>
                            <div class="form-group" style="flex: 1;">
                                <label>Telefone:</label>
                                <input type="text" name="telefone" class="form-control" placeholder="(00) 00000-0000" required value="<%= selectedUser.telefone || '' %>">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>E-mail:</label>
                            <input type="email" name="email" class="form-control" required value="<%= selectedUser.email || '' %>">
                        </div>

                        <div class="form-group">
                            <label>Senha:</label>
                            <input type="password" name="senha" class="form-control" 
                                placeholder="<%= selectedUser.id ? 'Deixe em branco para manter a atual' : 'Senha obrigatória' %>" 
                                <%= selectedUser.id ? '' : 'required' %>>
                        </div>

                        <div class="form-group">
                            <label>Tipo de Permissão:</label>
                            <select name="tipo" class="form-control">
                                <option value="funcionario" <%= (selectedUser.tipo === 'funcionario' || selectedUser.tipo === 'Funcionário') ? 'selected' : '' %>>Funcionário</option>
                                <option value="supervisor" <%= (selectedUser.tipo === 'supervisor' || selectedUser.tipo === 'Supervisor') ? 'selected' : '' %>>Supervisor (Admin)</option>
                                <option value="cliente" <%= (selectedUser.tipo === 'cliente') ? 'selected' : '' %>>Cliente</option>
                            </select>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn-submit">
                                <i class="fas fa-save"></i> Salvar Dados
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <% } %>
        </main>
    </body>
</html>