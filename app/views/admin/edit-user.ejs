<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Editar Usuário</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/admin/employees.css">
    <link rel="stylesheet" href="/css/admin/back.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <main>
        <div class="container" style="max-width: 800px; margin-top: 50px;">
            <div class="page-header">
                <div class="top-container">
                    <a class="top-link" href="/admin/users" aria-label="Voltar para a lista">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>
                        <span>Voltar</span>
                    </a>
                </div>

                <h1 class="page-title">Editar Usuário #<%= user.id %></h1>
            </div>

            <% if (typeof errorMessage !== 'undefined') { %>
                <div style="background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 20px; border-radius: 5px;">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div class="table-card" style="padding: 30px;">
                <form action="/admin/users/<%= user.id %>?_method=PUT" method="POST">
                    
                    <div class="form-group">
                        <label>Nome Completo:</label>
                        <input type="text" name="nome" class="form-control" required value="<%= user.nome %>">
                    </div>

                    <div class="form-group">
                        <label>Email:</label>
                        <input type="email" name="email" class="form-control" required value="<%= user.email %>">
                    </div>

                    <div style="display: flex; gap: 15px;">
                        <div class="form-group" style="flex: 1;">
                            <label>CPF (Apenas Leitura):</label>
                            <input type="text" name="cpf" class="form-control" value="<%= user.cpf %>" readonly style="background-color: #eee; cursor: not-allowed;">
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label>Telefone:</label>
                            <input type="text" name="telefone" class="form-control" value="<%= user.telefone %>">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Tipo de Usuário (Cargo):</label>
                        <select name="tipo" class="form-control">
                            <option value="funcionario" <%= user.tipo === 'funcionario' ? 'selected' : '' %>>Funcionário</option>
                            <option value="supervisor" <%= user.tipo === 'supervisor' ? 'selected' : '' %>>Supervisor</option>
                        </select>
                    </div>

                    <div style="margin-top: 20px; text-align: right;">
                        <button type="submit" class="btn-submit" style="padding: 10px 20px; font-size: 16px;">
                            <i class="fas fa-sync-alt"></i> Atualizar Dados
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>