<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/png" href="images/logo-better-nobackground.png">
        <title>Detalhes do Pedido #<%= order.id %></title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <link rel="stylesheet" href="/css/order-display.css">
        <link rel="stylesheet" href="/css/reset.css">
        <link rel="stylesheet" href="/css/header.css">
        <link rel="stylesheet" href="/css/footer.css">
        <link rel="stylesheet" href="/css/back.css">
    </head>
    <body>
        <%- include('../partials/header') %>

        <main>
            <div class="top-container" style="margin-top: 20px; margin-left: 20px;">
                <a class="top-link" href="/orders">
                    <i class="fas fa-arrow-left"></i> <span>Voltar para meus pedidos</span>
                </a>
            </div>

            <section class="order-section">
                <h2 class="order-section-title">Itens do Pedido</h2>
                
                <ul class="order-section-container">
                    <% products.forEach(item => { %>
                        <li class="order-section-item">
                            <div class="order-section-img-container">
                                <div class="order-section-name"><%= item.nome %></div>
                            </div>
                            
                            <div class="order-section-details-container">
                                <p class="order-section-quantity">Qtd: <%= item.quantidade %></p>
                            </div>
                            
                            <div class="order-section-details-container" style="flex-direction: column; align-items: flex-end; gap: 5px;">
                                <p class="order-section-price" style="font-weight: 400; font-size: 1.2rem;">Unidade: <%= item.preco.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></p>
                                <p class="order-section-price"><strong>Total: <%= (item.preco * item.quantidade).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></p>
                            </div>
                        </li>
                    <% }); %>
                </ul>
                
                <div class="order-section-total-container">
                    <% 
                        const totalPedido = products.reduce((acc, item) => acc + (item.preco * item.quantidade), 0);
                    %>
                    <h2 class="order-section-total">Total do Pedido: <%= totalPedido.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></h2>
                </div>
                
                </section>
        </main>

        <%- include('../partials/footer') %>
    </body>
</html>