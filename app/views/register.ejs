<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="Crie sua conta na Sinhá Bolos e Lanches para fazer pedidos de forma rápida e fácil.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="icon" type="image/png" href="images/logo-better-nobackground.png">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/back.css">
    <link rel="stylesheet" href="/css/register.css"> 
    <link rel="stylesheet" href="/css/footer.css"> 
    <link rel="stylesheet" href="/css/header.css">
    <title>Registrar - Sinhá Bolos e Lanches</title>

    <style>
        .register-input.input-error {
            border: 2px solid #dc3545 !important;
            background-color: #fff8f8;
        }

        .error-message {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>
<body>
    <% 
        const err = (typeof errors !== 'undefined') ? errors : {};
        const data = (typeof formData !== 'undefined') ? formData : {};
    %>

    <main>        
        <div class="register-main-container">
            <div class="top-container">
                <a class="top-link" href="login" aria-label="Voltar para a página de login">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    <span>Voltar</span>
                </a>

                <div class="header-accessibility-container">
                    <button id="header-accessibility-toggle-btn" class="header-dropdown" aria-label="Abrir menu de acessibilidade" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-universal-access"  aria-hidden="true"></i>
                    </button>
                    <div id="header-accessibility-menu" class="header-accessibility-menu">
                        <div class="header-acessibility-content">
                            <label for="font-size-control" class="header-acessibility-label">Tamanho da Fonte</label>
                            <div id="font-size-control" class="header-acessibility-btn-container">
                                <button id="font-decrease-btn" class="header-acessibility-btn" aria-label="Diminuir fonte">A-</button>
                                <button id="font-reset-btn" class="header-acessibility-btn" aria-label="Resetar fonte">A</button>
                                <button id="font-increase-btn" class="header-acessibility-btn" aria-label="Aumentar fonte">A+</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <section class="register-section" aria-labelledby="register-main-title">
                <div class="register-logo">
                    <div class="register-img-container">
                        <img class="register-img" src="images/logo-better-nobackground.png" alt="">
                    </div>
                    <h1 class="register-title" id="register-main-title">Sinhá Bolos e Lanches</h1>
                </div>

                <div class="form-container"> 
                    <form method="post" action="/register" class="register-form">
                        <div class="register-input-container">
                            <label class="register-label" for="input-name">*Nome</label>
                            <input type="text" 
                                   class="register-input <%= err.nome ? 'input-error' : '' %>" 
                                   name="nome" 
                                   id="input-name" 
                                   placeholder="Insira seu nome" 
                                   value="<%= data.nome || '' %>">
                            
                            <% if (err.nome) { %>
                                <span class="error-message"><i class="fas fa-exclamation-circle"></i> <%= err.nome %></span>
                            <% } %>
                        </div>

                        <div class="register-input-container">
                            <label class="register-label" for="input-email">*Email</label>
                            <input type="email" 
                                   class="register-input <%= err.email ? 'input-error' : '' %>" 
                                   name="email" 
                                   id="input-email" 
                                   placeholder="Insira seu email"
                                   value="<%= data.email || '' %>">

                            <% if (err.email) { %>
                                <span class="error-message"><i class="fas fa-exclamation-circle"></i> <%= err.email %></span>
                            <% } %>
                        </div>

                        <div class="register-input-container">
                            <label class="register-label" for="input-phone">*Telefone</label>
                            <input 
                                type="number" 
                                class="register-input <%= err.telefone ? 'input-error' : '' %>" 
                                name="telefone" 
                                id="input-phone" 
                                placeholder="Apenas números (DDD + Número)" 
                                inputmode="numeric"
                                value="<%= data.telefone || '' %>"
                            >
                            <% if (err.telefone) { %>
                                <span class="error-message"><i class="fas fa-exclamation-circle"></i> <%= err.telefone %></span>
                            <% } %>
                        </div>

                        <div class="register-input-container">
                            <label class="register-label" for="input-cpf">*CPF</label>
                            <input 
                                type="number" 
                                class="register-input <%= err.cpf ? 'input-error' : '' %>" 
                                name="cpf" 
                                id="input-cpf" 
                                placeholder="Apenas números" 
                                inputmode="numeric"
                                value="<%= data.cpf || '' %>"
                            >

                            <% if (err.cpf) { %>
                                <span class="error-message"><i class="fas fa-exclamation-circle"></i> <%= err.cpf %></span>
                            <% } %>
                        </div>

                        <div class="register-input-container">
                            <label class="register-label" for="input-password">*Senha</label>
                            <input type="password" 
                                   class="register-input <%= err.senha ? 'input-error' : '' %>" 
                                   name="senha" 
                                   id="input-password" 
                                   placeholder="Insira sua senha">

                            <% if (err.senha) { %>
                                <span class="error-message"><i class="fas fa-exclamation-circle"></i> <%= err.senha %></span>
                            <% } %>
                        </div>

                        <div class="register-input-container">
                            <label class="register-label" for="input-confirm-password">*Confirmar senha</label>
                            <input type="password" 
                                   class="register-input <%= err['confirm-password'] ? 'input-error' : '' %>" 
                                   name="confirm-password" 
                                   id="input-confirm-password" 
                                   placeholder="Insira sua senha novamente">

                            <% if (err['confirm-password']) { %>
                                <span class="error-message"><i class="fas fa-exclamation-circle"></i> <%= err['confirm-password'] %></span>
                            <% } %>
                        </div>

                        <div id="register-button-container">
                            <button id="register-button" class="register-button" type="submit">Registrar</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/utility.js" type="module"></script>
</body>
</html>