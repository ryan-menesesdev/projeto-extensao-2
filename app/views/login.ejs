<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="Acesse sua conta na Sinhá Bolos e Lanches para fazer pedidos e ver seu histórico.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="icon" type="image/png" href="images/logo-better-nobackground.png">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/back.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/footer.css"> 
    <link rel="stylesheet" href="/css/header.css">
    <title>Login - Sinhá Bolos e Lanches</title>

    <style>
        .login-input.input-error {
            border: 2px solid #dc3545 !important;
            background-color: #fff8f8;
        }

        .error-message {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            font-family: 'Poppins', sans-serif;
            text-align: left; 
        }
    </style>
</head>
<body>
    
    <% 
        const err = (typeof errors !== 'undefined') ? errors : {};
        const data = (typeof formData !== 'undefined') ? formData : {};
    %>

    <main>
        <div class="login-main-container">
            <div class="top-container">
                <a class="top-link" href="/" aria-label="Voltar para a página inicial">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    <span>Voltar</span>
                </a>

                <div class="register-container">
                    <div class="header-accessibility-container">
                        <button id="header-accessibility-toggle-btn" class="header-dropdown" aria-label="Abrir menu de acessibilidade" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-universal-access" aria-hidden="true"></i>
                        </button>
                        <div id="header-accessibility-menu" class="header-accessibility-menu">
                            <div class="header-acessibility-content">
                                <label for="font-size-control" class="header-acessibility-label">Tamanho da Fonte</label>
                                <div id="font-size-control" class="header-acessibility-btn-container">
                                    <button id="font-decrease-btn" class="header-acessibility-btn" aria-label="Diminuir fonte">A-</button>
                                    <button id="font-reset-btn" class="header-acessibility-btn" aria-label="Resetar fonte">A</button>
                                    <button id="font-increase-btn" class="header-acessibility-btn" aria-label="Aumentar fonte">A+</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <a href="/register">
                        <button id="register-button" class="login-button">Registrar-se</button>
                    </a>
                </div>                
            </div>

            <section class="login-section" aria-labelledby="login-title">
                <div class="login-logo">
                    <div class="login-img-container">
                        <img class="login-img" src="images/logo-better-nobackground.png" alt="">
                    </div>
                    <h1 class="login-title" id="login-title">Sinhá Bolos e Lanches</h1>
                </div>

                <div class="form-container">
                    <form method="post" action="/login" class="login-form" novalidate>
                        
                        <div class="login-input-container">
                            <label class="login-label" for="input-email">*Email</label>
                            <input 
                                type="email" 
                                class="login-input <%= err.email ? 'input-error' : '' %>" 
                                name="email" 
                                id="input-email" 
                                placeholder="Insira seu email" 
                                value="<%= data.email || '' %>"
                            >
                            <% if (err.email) { %>
                                <span class="error-message"><i class="fas fa-exclamation-circle"></i> <%= err.email %></span>
                            <% } %>
                        </div>

                        <div class="login-input-container">
                            <label class="login-label" for="input-password">*Senha</label>
                            <input 
                                type="password" 
                                class="login-input <%= err.senha ? 'input-error' : '' %>" 
                                name="senha" 
                                id="input-password" 
                                placeholder="Insira sua senha" 
                            >
                            <% if (err.senha) { %>
                                <span class="error-message"><i class="fas fa-exclamation-circle"></i> <%= err.senha %></span>
                            <% } %>
                        </div>

                        <div id="login-button-container">
                            <button id="login-button" class="login-button" type="submit">Entrar</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/utility.js" type="module"></script>
</body>
</html>